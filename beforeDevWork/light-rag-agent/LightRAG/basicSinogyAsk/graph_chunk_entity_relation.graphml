      <data key="d1">person</data>
      <data key="d2">劉宗周 is an important figure in the Cheng-Zhu school recognized for his work《論語學案》 that explores the Analects.</data>
      <data key="d3">chunk-d29ad594769c8b8c4a1737560d16e767</data>
      <data key="d4">unknown_source</data>
    </node>
