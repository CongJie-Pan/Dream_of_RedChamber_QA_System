      <data key="d0">周宗建</data>
      <data key="d1">person</data>
      <data key="d2">周宗建 is a representative scholar of the Cheng-Zhu school, known for his work《論語商》 that elaborates on the Analects.</data>
      <data key="d3">chunk-d29ad594769c8b8c4a1737560d16e767</data>
      <data key="d4">unknown_source</data>
    </node>
