    <node id="Zizhi Tongjian">
      <data key="d0">Zizhi Tongjian</data>
      <data key="d1">event</data>
      <data key="d2">The 'Zizhi Tongjian' is a renowned chronicle by Sima Guang from the Song dynasty that serves as a historical reference for rulers, composed in chronicle style.</data>
      <data key="d3">chunk-3920bf7b7788b93ba65dcf473dd05164</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="Records of the Grand Historian">
      <data key="d0">Records of the Grand Historian</data>
      <data key="d1">event</data>
      <data key="d2">The 'Records of the Grand Historian' by Sima Qian pioneered the biographical style, dividing history into several structured parts.</data>
