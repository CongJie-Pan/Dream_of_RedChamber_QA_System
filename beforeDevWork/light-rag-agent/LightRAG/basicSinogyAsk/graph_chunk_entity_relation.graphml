    <node id="伏羲">
      <data key="d0">伏羲</data>
      <data key="d1">person</data>
      <data key="d2">伏羲 is a legendary figure credited with creating the eight trigrams that form the basis of《周易》.&lt;SEP&gt;伏羲 is a legendary figure in Chinese history, credited with the creation of the eight trigrams that serve as the foundation of《周易》。</data>
      <data key="d3">chunk-79e0519e059bd1b7719df554b4821058</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="周文王">
      <data key="d0">周文王</data>
      <data key="d1">person</data>
      <data key="d2">周文王 is historically recognized for expanding the eight trigrams into sixty-four hexagrams and for authoring significant commentaries on《周易》。&lt;SEP&gt;周文王 is traditionally believed to have expanded the eight trigrams into sixty-four hexagrams and contributed to the text with commentary.</data>
      <data key="d3">chunk-79e0519e059bd1b7719df554b4821058</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="十翼">
      <data key="d0">十翼</data>
      <data key="d1">category</data>
      <data key="d2">The Ten Wings are a collection of commentaries on《周易》 that provide philosophical insight into the text's meanings.&lt;SEP&gt;The Ten Wings are a collection of commentaries that explain and elaborate on the concepts within《周易》，deepening its philosophical understanding.</data>
      <data key="d3">chunk-79e0519e059bd1b7719df554b4821058</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="上經">
      <data key="d0">上經</data>
      <data key="d1">category</data>
      <data key="d2">The Upper Text of《周易》 consists of thirty hexagrams that articulate the principles of the cosmos and their implications for human behavior.&lt;SEP&gt;The Upper Text refers to the first thirty hexagrams of《周易》 that discuss cosmic principles.</data>
      <data key="d3">chunk-79e0519e059bd1b7719df554b4821058</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="下經">
      <data key="d0">下經</data>
      <data key="d1">category</data>
      <data key="d2">The Lower Text comprises the last thirty-four hexagrams of《周易》, which focus on human relations.&lt;SEP&gt;The Lower Text of《周易》 comprises thirty-four hexagrams that explore human relationships and ethical behavior.</data>
      <data key="d3">chunk-79e0519e059bd1b7719df554b4821058</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="陰陽">
      <data key="d0">陰陽</data>
      <data key="d1">category</data>
      <data key="d2">Yin and Yang represent fundamental dualities in Chinese philosophy, crucial to the understanding of《周易》's concepts.&lt;SEP&gt;Yin and Yang represent fundamental dualities in Chinese philosophy, essential for interpreting much of the thinking present in《周易》。</data>
      <data key="d3">chunk-79e0519e059bd1b7719df554b4821058</data>
      <data key="d4">unknown_source</data>
    </node>
