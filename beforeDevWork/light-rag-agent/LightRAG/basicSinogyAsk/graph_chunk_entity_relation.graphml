    <node id="《周易》">
      <data key="d0">《周易》</data>
      <data key="d1">event</data>
      <data key="d2">《周易》 is an ancient Chinese classic text that delves into divination methods and philosophical reflections on change, greatly influencing Chinese culture and thought.&lt;SEP&gt;《周易》 is an ancient Chinese classic that explores philosophical thoughts and divination methods, significantly influencing Chinese culture and thought.</data>
      <data key="d3">chunk-79e0519e059bd1b7719df554b4821058</data>
      <data key="d4">unknown_source</data>
