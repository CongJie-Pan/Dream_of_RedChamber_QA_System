      <data key="d2">《小戴禮記》是戴聖所選定的篇章，是今之《禮記》的重要來源。</data>
      <data key="d3">chunk-7278dcffdedbc9d941ecc947495f58a2</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="《大戴禮記》">
      <data key="d0">《大戴禮記》</data>
      <data key="d1">category</data>
      <data key="d2">《大戴禮記》是根據戴德和戴聖的選擇而成，含有關於禮的重要篇章。</data>
      <data key="d3">chunk-7278dcffdedbc9d941ecc947495f58a2</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="《小戴禮記》">
      <data key="d0">《小戴禮記》</data>
      <data key="d1">category</data>
      <data key="d2">《小戴禮記》是戴聖所選定的篇章，是今之《禮記》的重要來源。</data>
      <data key="d3">chunk-7278dcffdedbc9d941ecc947495f58a2</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="儒家思想">
      <data key="d0">儒家思想</data>
      <data key="d1">category</data>
      <data key="d2">儒家思想是基於孔子教導而發展的哲學體系，涵蓋了倫理學、政治和教育等範疇。</data>
      <data key="d3">chunk-7278dcffdedbc9d941ecc947495f58a2</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="戴德">
      <data key="d0">戴德</data>
      <data key="d1">person</data>
      <data key="d2">戴德是漢朝的經師之一，他參與編纂《大戴禮記》。</data>
      <data key="d3">chunk-7278dcffdedbc9d941ecc947495f58a2</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="戴聖">
      <data key="d0">戴聖</data>
      <data key="d1">person</data>
      <data key="d2">戴聖是另一位漢朝經師，與戴德合作編纂《小戴禮記》。</data>
      <data key="d3">chunk-7278dcffdedbc9d941ecc947495f58a2</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="《三禮》">
      <data key="d0">《三禮》</data>
      <data key="d1">category</data>
      <data key="d2">《三禮》是儒家經典的總稱，包括《儀禮》、《禮記》和《大戴禮記》。</data>
      <data key="d3">chunk-7278dcffdedbc9d941ecc947495f58a2</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="規範">
      <data key="d0">規範</data>
      <data key="d1">category</data>
      <data key="d2">規範是指社會中普遍認可的行為準則，與儀禮有密切關聯。</data>
      <data key="d3">chunk-7278dcffdedbc9d941ecc947495f58a2</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="教學理論">
      <data key="d0">教學理論</data>
      <data key="d1">category</data>
      <data key="d2">教學理論探討如何有效進行教學，與《禮記》中出現的教學觀念有關。</data>
      <data key="d3">chunk-7278dcffdedbc9d941ecc947495f58a2</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="元明經學">
      <data key="d0">元明經學</data>
      <data key="d1">category</data>
      <data key="d2">元明經學 refers to the study of Confucian classics during the Yuan and Ming dynasties, characterized by a focus on the examination system and its impact on scholarly pursuits.</data>
      <data key="d3">chunk-11dfd439fd6d3c992e3423f02b061159</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="科舉制度">
      <data key="d0">科舉制度</data>
      <data key="d1">organization</data>
      <data key="d2">The 科舉制度 is the imperial examination system used in China to select candidates for the government, significantly influencing the scholarly world during the Yuan and Ming dynasties.</data>
      <data key="d3">chunk-11dfd439fd6d3c992e3423f02b061159</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="朱子學">
      <data key="d0">朱子學</data>
      <data key="d1">category</data>
      <data key="d2">朱子學 is a school of thought founded by Zhu Xi, influential in shaping Confucian philosophy and education during the Yuan dynasty.</data>
      <data key="d3">chunk-11dfd439fd6d3c992e3423f02b061159</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="元代">
      <data key="d0">元代</data>
      <data key="d1">geo</data>
      <data key="d2">元代 refers to the Yuan dynasty, which was marked by Mongolian rule over China and a diminished emphasis on traditional education.</data>
      <data key="d3">chunk-11dfd439fd6d3c992e3423f02b061159</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="明代">
      <data key="d0">明代</data>
      <data key="d1">geo</data>
      <data key="d2">明代 refers to the Ming dynasty, characterized by a revival of Confucian values and the continuation of the imperial examination system.</data>
      <data key="d3">chunk-11dfd439fd6d3c992e3423f02b061159</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="四書五經大全">
      <data key="d0">四書五經大全</data>
      <data key="d1">category</data>
      <data key="d2">四書五經大全 is a comprehensive reference book for the imperial examination system, criticized for its inadequacy by scholars like 顧炎武.</data>
      <data key="d3">chunk-11dfd439fd6d3c992e3423f02b061159</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="程朱理學">
      <data key="d0">程朱理學</data>
      <data key="d1">category</data>
      <data key="d2">程朱理學 is a faction of Confucianism that flourished during the Ming dynasty, focusing on moral and metaphysical inquiries, with prominent figures contributing to its teachings.</data>
      <data key="d3">chunk-11dfd439fd6d3c992e3423f02b061159</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="反宋復漢">
      <data key="d0">反宋復漢</data>
      <data key="d1">category</data>
      <data key="d2">反宋復漢 represents a scholarly movement during the Ming dynasty that opposed Song teachings while seeking to revive Han learning.</data>
      <data key="d3">chunk-11dfd439fd6d3c992e3423f02b061159</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="偽經之作">
      <data key="d0">偽經之作</data>
      <data key="d1">category</data>
      <data key="d2">偽經之作 refers to the phenomenon of producing forged classical texts during the Ming dynasty due to shallow scholarly pursuits.</data>
      <data key="d3">chunk-11dfd439fd6d3c992e3423f02b061159</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="士人">
      <data key="d0">士人</data>
      <data key="d1">category</data>
      <data key="d2">士人 refers to the scholars or literati who were prominent figures in Chinese society, especially during the Yuan and Ming dynasties, often pursuing education through the imperial examination system.</data>
      <data key="d3">chunk-11dfd439fd6d3c992e3423f02b061159</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="蒙族">
      <data key="d0">蒙族</data>
      <data key="d1">geo</data>
      <data key="d2">蒙族 refers to the Mongolian ethnic group that ruled China during the Yuan dynasty, impacting the cultural and educational developments of that period.</data>
      <data key="d3">chunk-11dfd439fd6d3c992e3423f02b061159</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="讀書人">
      <data key="d0">讀書人</data>
      <data key="d1">person</data>
      <data key="d2">讀書人 are individuals who engage in study and scholarship, particularly in the context of preparing for the imperial examinations during the Yuan and Ming dynasties.</data>
      <data key="d3">chunk-11dfd439fd6d3c992e3423f02b061159</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="考試">
      <data key="d0">考試</data>
      <data key="d1">event</data>
      <data key="d2">考試 refers to the examination process that scholars underwent to obtain governmental positions, centered around Confucian texts and principles during the Yuan and Ming periods.</data>
      <data key="d3">chunk-11dfd439fd6d3c992e3423f02b061159</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="陰陽五行">
      <data key="d0">陰陽五行</data>
      <data key="d1">category</data>
      <data key="d2">陰陽五行 is a philosophical and cosmological concept in Chinese thought related to the duality of forces and the five elements, often referenced in Confucian and historical contexts.</data>
      <data key="d3">chunk-11dfd439fd6d3c992e3423f02b061159</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="宋學">
      <data key="d0">宋學</data>
      <data key="d1">category</data>
      <data key="d2">宋學 refers to the teachings and philosophical principles of the Song dynasty, which were foundational for later Confucian scholars, particularly in contrast to the Ming dynasty's perspectives.</data>
      <data key="d3">chunk-11dfd439fd6d3c992e3423f02b061159</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="學術固化">
      <data key="d0">學術固化</data>
      <data key="d1">category</data>
      <data key="d2">學術固化 describes the phenomenon of stagnation in academic and intellectual growth, particularly in the context of Confucian studies during the Yuan and Ming dynasties.</data>
      <data key="d3">chunk-11dfd439fd6d3c992e3423f02b061159</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="荀子">
      <data key="d0">荀子</data>
      <data key="d1">person</data>
      <data key="d2">荀子強調外在學習和制度約束，重視禮樂的理論建設與經學的傳承。&lt;SEP&gt;荀子是另一位重要的儒學思想家，他重視禮樂，強調外在的學習和制度約束。</data>
      <data key="d3">chunk-e06e41970449ac931423e76276bd2a5b&lt;SEP&gt;chunk-778f057ebbb3f89bd1278c6c6c69bc3a</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="先秦經學">
      <data key="d0">先秦經學</data>
      <data key="d1">category</data>
      <data key="d2">先秦經學 refers to the foundational period of Confucian scholarship in ancient China, marking an important development in Chinese intellectual history.&lt;SEP&gt;先秦經學是中國經學發展的重要時期，涉及儒家思想的起源和六經的整理。</data>
      <data key="d3">chunk-e06e41970449ac931423e76276bd2a5b&lt;SEP&gt;chunk-778f057ebbb3f89bd1278c6c6c69bc3a</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="《樂經》">
      <data key="d0">《樂經》</data>
      <data key="d1">category</data>
      <data key="d2">《樂經》是六經之一，與音樂、禮儀相關，是貴族的教育教材。</data>
      <data key="d3">chunk-778f057ebbb3f89bd1278c6c6c69bc3a</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="士大夫">
      <data key="d0">士大夫</data>
      <data key="d1">person</data>
      <data key="d2">士大夫是指在先秦社會中，具有一定地位和受過教育的文人階級。他們在社會交往中經常引用《詩經》。</data>
      <data key="d3">chunk-778f057ebbb3f89bd1278c6c6c69bc3a</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="《毛詩》">
      <data key="d0">《毛詩》</data>
      <data key="d1">category</data>
      <data key="d2">《毛詩》是傳承自荀子的經典之一，與詩歌的教育和傳承有關。</data>
      <data key="d3">chunk-778f057ebbb3f89bd1278c6c6c69bc3a</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="中國經學">
      <data key="d0">中國經學</data>
      <data key="d1">category</data>
      <data key="d2">中國經學 refers to the study and interpretation of classical Chinese texts, originating from the teachings of Confucius and other scholars in ancient China.</data>
      <data key="d3">chunk-e06e41970449ac931423e76276bd2a5b</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="士大夫階層">
      <data key="d0">士大夫階層</data>
      <data key="d1">category</data>
      <data key="d2">士大夫階層 refers to the scholarly and noble class in ancient China, who were the primary audience and practitioners of Confucian teachings, including the study of the Six Classics.</data>
      <data key="d3">chunk-e06e41970449ac931423e76276bd2a5b</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="詩經中的賦詩和隱詩傳統">
      <data key="d0">詩經中的賦詩和隱詩傳統</data>
      <data key="d1">category</data>
      <data key="d2">詩經中的賦詩和隱詩傳統 involves the dual forms of poetic expression found in the Book of Songs, used for communication among the elite class.</data>
      <data key="d3">chunk-e06e41970449ac931423e76276bd2a5b</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="六經的基本範圍和內容">
      <data key="d0">六經的基本範圍和內容</data>
      <data key="d1">category</data>
      <data key="d2">六經的基本範圍和內容 outlines the core canonical texts of Confucianism, including their themes and teachings.</data>
      <data key="d3">chunk-e06e41970449ac931423e76276bd2a5b</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="《詩經》">
      <data key="d0">《詩經》</data>
      <data key="d3">chunk-778f057ebbb3f89bd1278c6c6c69bc3a</data>
      <data key="d2">士大夫在交流中引用《詩經》，顯示了其在社會交往中的重要性。</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="兩漢經學">
      <data key="d0">兩漢經學</data>
      <data key="d1">category</data>
      <data key="d2">兩漢經學是指中國漢朝及其之前的經學發展，特別是在儒學的推廣和應用方面，它標誌著經學的昌盛時期。&lt;SEP&gt;兩漢經學是指中國漢朝期間的經學發展，特別是在儒學的推廣和應用方面。</data>
      <data key="d3">chunk-315077752de6779a4597b96eec2f7e30</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="劉邦">
      <data key="d0">劉邦</data>
      <data key="d1">person</data>
      <data key="d2">劉邦是漢朝的創始皇帝，他的統治對於漢代的文化與經學發展有深厚的影響。&lt;SEP&gt;劉邦是漢朝的創始皇帝，對儒學的重視程度一直受到爭議。</data>
      <data key="d3">chunk-315077752de6779a4597b96eec2f7e30</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="漢武帝">
      <data key="d0">漢武帝</data>
      <data key="d1">person</data>
      <data key="d2">漢武帝是漢朝的第七位皇帝，以推廣儒學和經學聞名，並設立五經博士。&lt;SEP&gt;漢武帝是漢朝的第七位皇帝，因推廣儒學和設立五經博士而被認為是經學發展的重要推手。</data>
      <data key="d3">chunk-315077752de6779a4597b96eec2f7e30</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="陰陽五行論">
      <data key="d0">陰陽五行論</data>
      <data key="d1">category</data>
      <data key="d2">The '陰陽五行論' (Theory of Yin-Yang and Five Elements) is a philosophical framework in Chinese thought that explains the interactions and relationships between natural forces.&lt;SEP&gt;陰陽五行論是中國古代思想體系之一，用來解釋自然和社會現象，與經學有密切關係。&lt;SEP&gt;陰陽五行論是解釋宇宙和自然現象的理論，是漢代思想的重要組成部分。</data>
      <data key="d3">chunk-315077752de6779a4597b96eec2f7e30&lt;SEP&gt;chunk-5695efccc9909134c743fd87907cce18</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="經學昌盛時期">
      <data key="d0">經學昌盛時期</data>
      <data key="d1">event</data>
      <data key="d2">經學昌盛時期指的是漢朝對經學的重視，經典研究與儒學普及的高峰時期。&lt;SEP&gt;經學昌盛時期是指漢朝時期，經學特別是儒學得到了廣泛的發展和應用。</data>
      <data key="d3">chunk-315077752de6779a4597b96eec2f7e30</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="漢高祖">
      <data key="d0">漢高祖</data>
      <data key="d1">person</data>
      <data key="d2">漢高祖即劉邦，是漢朝的開創者，對儒學的重視與其政策在經學發展中起到關鍵作用。</data>
      <data key="d3">chunk-315077752de6779a4597b96eec2f7e30</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="七國之亂">
      <data key="d0">七國之亂</data>
      <data key="d1">event</data>
      <data key="d2">七國之亂是漢初發生的一場內亂，對漢朝的統治和經學政策有重大影響。</data>
      <data key="d3">chunk-315077752de6779a4597b96eec2f7e30</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="三綱五常">
      <data key="d0">三綱五常</data>
      <data key="d1">category</data>
      <data key="d2">三綱五常是儒家基本的道德規範，強調社會秩序和道德義務。</data>
      <data key="d3">chunk-315077752de6779a4597b96eec2f7e30</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="太學">
      <data key="d0">太學</data>
      <data key="d1">organization</data>
      <data key="d2">太學是漢朝最高的學術機構，專門提供儒學教育及進行經典研究。</data>
      <data key="d3">chunk-315077752de6779a4597b96eec2f7e30</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="公羊家">
      <data key="d0">公羊家</data>
      <data key="d1">organization</data>
      <data key="d2">公羊家 is a scholarly school derived from Confucian teachings, specifically centered on the interpretation of the '春秋經' (Spring and Autumn Annals).</data>
      <data key="d3">chunk-5695efccc9909134c743fd87907cce18</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="齊學">
      <data key="d0">齊學</data>
      <data key="d1">organization</data>
      <data key="d2">齊學 is a philosophical school that discusses metaphysical concepts, influencing the development of 公羊家 and its focus on 陰陽五行.</data>
      <data key="d3">chunk-5695efccc9909134c743fd87907cce18</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="魯國">
      <data key="d0">魯國</data>
      <data key="d1">geo</data>
      <data key="d2">魯國 (State of Lu) is the historical context within which Confucius operated and where the '春秋經' originated.</data>
      <data key="d3">chunk-5695efccc9909134c743fd87907cce18</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="五經博士">
      <data key="d0">五經博士</data>
      <data key="d3">chunk-315077752de6779a4597b96eec2f7e30</data>
      <data key="d2">漢武帝設立五經博士來專門研究和推廣儒學經典，象徵經學的發展。</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="經學史">
      <data key="d0">經學史</data>
      <data key="d1">category</data>
      <data key="d2">經學史 refers to the study of classical texts and their interpretations, with a distinct focus on developments during the Song Dynasty.</data>
