      <data key="d0">今文尚書</data>
      <data key="d1">category</data>
      <data key="d2">今文尚書是以漢代隸書寫成的版本，主要為漢朝的學者所使用。</data>
      <data key="d3">chunk-3ab078e945b47999b74ddc9b6c51aeab</data>
      <data key="d4">unknown_source</data>
    </node>
