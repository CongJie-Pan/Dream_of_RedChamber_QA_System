      <data key="d0">伏生</data>
      <data key="d1">person</data>
      <data key="d2">伏生是古代文學家，被認為在秦焚書運動後保留了今文尚書的版本。</data>
      <data key="d3">chunk-3ab078e945b47999b74ddc9b6c51aeab</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="偽孔序">
      <data key="d0">偽孔序</data>
      <data key="d1">category</data>
      <data key="d2">偽孔序是附於偽古文尚書的序文，經過考證為孔安國所作的偽作。</data>
      <data key="d3">chunk-3ab078e945b47999b74ddc9b6c51aeab</data>
