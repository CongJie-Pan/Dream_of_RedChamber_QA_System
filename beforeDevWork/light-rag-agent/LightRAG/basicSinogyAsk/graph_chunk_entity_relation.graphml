    </node>
    <node id="《十翼》">
      <data key="d0">《十翼》</data>
      <data key="d1">category</data>
      <data key="d2">《十翼》是《周易》的重要注释部分，对于理解《周易》的哲学思想提供了深刻的见解。</data>
      <data key="d3">chunk-114ae7417f2464f12b59d413a2a9ef94</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="顾炎武">
      <data key="d0">顾炎武</data>
      <data key="d1">person</data>
      <data key="d2">顾炎武是明末清初的学者，他的《日知录》对《易经》的解读和实践有重要影响。</data>
      <data key="d3">chunk-114ae7417f2464f12b59d413a2a9ef94</data>
