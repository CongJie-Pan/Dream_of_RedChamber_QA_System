    <node id="劉知幾">
      <data key="d0">劉知幾</data>
      <data key="d1">person</data>
      <data key="d2">劉知幾是唐代的歷史學家，著作《史通》開創了批評史書的學科。</data>
      <data key="d3">chunk-41d60f49b80f79dc8e2ce29d36c2536a</data>
