      <data key="d1">person</data>
      <data key="d2">陳啟原 was a scholar in the Qing dynasty known for his work on the revival of classical literature.</data>
      <data key="d3">chunk-2052f122203d0c467d6ec2d975457a07</data>
      <data key="d4">unknown_source</data>
    </node>
