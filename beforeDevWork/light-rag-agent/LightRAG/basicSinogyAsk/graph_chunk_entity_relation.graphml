    <node id="History Writing">
      <data key="d0">History Writing</data>
      <data key="d1">category</data>
      <data key="d2">History writing encompasses various styles and forms that document historical events, often reflecting cultural and societal values.</data>
      <data key="d3">chunk-3920bf7b7788b93ba65dcf473dd05164</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="Chronicle Style">
      <data key="d0">Chronicle Style</data>
      <data key="d1">category</data>
      <data key="d2">Chronicle style is a method of documenting historical events in chronological order and is recognized as one of the earliest forms of historical writing.</data>
      <data key="d3">chunk-3920bf7b7788b93ba65dcf473dd05164</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="Biographical Style">
      <data key="d0">Biographical Style</data>
      <data key="d1">category</data>
      <data key="d2">Biographical style centers on individuals and uses timelines to narrate historical events, placing characters as focal points.</data>
      <data key="d3">chunk-3920bf7b7788b93ba65dcf473dd05164</data>
      <data key="d4">unknown_source</data>
    </node>
