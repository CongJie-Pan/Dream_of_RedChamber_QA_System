      <data key="d0">Event-Centric Style</data>
      <data key="d1">category</data>
      <data key="d2">Event-centric style focuses on significant events to provide a comprehensive view of history and its implications.</data>
      <data key="d3">chunk-3920bf7b7788b93ba65dcf473dd05164</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="Political Treatises">
      <data key="d0">Political Treatises</data>
      <data key="d1">category</data>
      <data key="d2">Political treatises concentrate on recording the history of rules and regulations, reflecting the governance and societal structures of the time.</data>
      <data key="d3">chunk-3920bf7b7788b93ba65dcf473dd05164</data>
