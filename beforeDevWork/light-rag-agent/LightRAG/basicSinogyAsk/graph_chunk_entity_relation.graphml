    <node id="北宋易学">
      <data key="d0">北宋易学</data>
      <data key="d1">event</data>
      <data key="d2">北宋时期易学发展为图书之学，强调图表解释易卦，代表人物包括刘牧和邵雍。</data>
      <data key="d3">chunk-114ae7417f2464f12b59d413a2a9ef94</data>
