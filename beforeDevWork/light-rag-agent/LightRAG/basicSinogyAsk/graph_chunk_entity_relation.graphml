    </node>
    <node id="史記">
      <data key="d0">史記</data>
      <data key="d1">category</data>
      <data key="d2">史記, or Records of the Grand Historian, is a foundational historical text in Chinese literature authored by Sima Qian.</data>
      <data key="d3">chunk-2052f122203d0c467d6ec2d975457a07</data>
      <data key="d4">unknown_source</data>
    </node>
    <node id="陳啟原">
