    <node id="Tongdian">
      <data key="d0">Tongdian</data>
      <data key="d1">event</data>
      <data key="d2">The 'Tongdian' by Du You is the first political treatise compiling governmental regulations, laying the foundation for the historical study of institutions.</data>
